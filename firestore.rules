rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function access() {
      return get(/databases/$(database)/documents/communityAccess/at-club).data;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == access().ownerUid;
    }

    function isAdmin() {
      return signedIn() && (isOwner() || request.auth.uid in access().adminUids);
    }

    match /communityMeta/at-club {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityAccess/at-club {
      allow read: if signedIn();
      allow create: if request.auth != null
        && request.auth.token.owner == true
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner();
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'active'
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.status == 'used'
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if isOwner();
    }

    match /communities/at-club {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['events', 'messages', 'directMessages', 'posts', 'cancellationRequests'])
      );
    }

    match /communities/at-club/profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'bio', 'initials', 'color', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.bio is string
        && request.resource.data.initials is string
        && request.resource.data.color is string;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nickname', 'bio', 'initials', 'color', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.bio is string
        && request.resource.data.initials is string
        && request.resource.data.color is string;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /communities/at-club/users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
