rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function access() {
      return get(/databases/$(database)/documents/communityAccess/at-club).data;
    }

    function hasOwnerClaim() {
      return signedIn() && (
        request.auth.token.owner == true
        || request.auth.token.role == 'owner'
      );
    }

    function isOwner() {
      return hasOwnerClaim()
        || (exists(/databases/$(database)/documents/communityAccess/at-club)
          && request.auth.uid == access().ownerUid);
    }

    function isAdmin() {
      return signedIn() && (
        isOwner()
        || (exists(/databases/$(database)/documents/communityAccess/at-club)
          && request.auth.uid in access().adminUids)
      );
    }

    match /communityMeta/at-club {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityAccess/at-club {
      allow read: if signedIn();
      allow create: if hasOwnerClaim()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner();
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'active'
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.status == 'used'
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if isOwner();
    }

    match /communities/at-club {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    match /communities/at-club/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorUid', 'author', 'initials', 'color', 'time', 'text', 'mine', 'createdAt'
        ]);
    }

    match /communities/at-club/directMessages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.keys().hasOnly([
          'senderUid', 'authorUid', 'recipientName', 'author', 'initials', 'color',
          'time', 'text', 'mine', 'participantUids', 'createdAt'
        ]);
    }

    match /communities/at-club/posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorUid', 'author', 'initials', 'color', 'time', 'label', 'text',
          'likes', 'liked', 'comments', 'createdAt', 'imageUrl'
        ])
        && (!request.resource.data.keys().hasAny(['imageUrl'])
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 650000));
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'liked', 'comments']);
    }

    match /communities/at-club/cancellationRequests/{requestId} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid', 'eventId', 'eventTitle', 'date', 'day', 'time', 'venue',
          'requestedAt', 'status', 'createdAt'
        ]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /communities/at-club/profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'bio', 'initials', 'color', 'avatarUrl', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.bio is string
        && request.resource.data.initials is string
        && request.resource.data.color is string
        && (!request.resource.data.keys().hasAny(['avatarUrl'])
          || request.resource.data.avatarUrl is string);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nickname', 'bio', 'initials', 'color', 'avatarUrl', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.bio is string
        && request.resource.data.initials is string
        && request.resource.data.color is string
        && request.resource.data.avatarUrl is string;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /communities/at-club/presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'lastSeen'])
        && request.resource.data.uid == userId
        && request.resource.data.lastSeen is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /communities/at-club/users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
